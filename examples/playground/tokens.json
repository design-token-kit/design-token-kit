      },
      "status-success": {
        "$value": "{primitive.color.success-500}",
        "$description": "Colour of the success status."
      },
      "status-warning": {
        "$value": "{primitive.color.warning-500}",
        "$description": "Colour of the warning status."
      },
      "status-danger": {
        "$value": "{primitive.color.danger-500}",
