{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
      "white": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "alpha": 1,
          "hex": "#ffffff"
        },
        "$description": "Absolute white. Base of light surfaces."
      },
      "black": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 1,
          "hex": "#000000"
        },
        "$description": "Absolute black. Base of shadows and overlays."
      },
      "overlay-40": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.4,
          "hex": "#000000"
        },
        "$description": "Translucent black dimming the background under modal layers."
      },
      "slate-100": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.945,
            0.961,
            0.976
          ],
          "alpha": 1,
          "hex": "#f1f5f9"
        },
        "$description": "Light neutral. Background of secondary surfaces."
      },
      "slate-300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.796,
            0.835,
            0.882
          ],
          "alpha": 1,
          "hex": "#cbd5e1"
        },
        "$description": "Mid neutral. Borders and dividers."
      },
      "slate-600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.278,
            0.333,
            0.412
          ],
          "alpha": 1,
          "hex": "#475569"
        },
        "$description": "Dark neutral. Secondary text."
      },
      "slate-900": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.059,
            0.09,
            0.165
          ],
          "alpha": 1,
          "hex": "#0f172a"
        },
        "$description": "Darkest neutral. Primary text."
      },
      "brand-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.145,
            0.286,
            0.965
          ],
          "alpha": 1,
          "hex": "#2549f6"
        },
        "$description": "Primary brand colour. Resting state of active elements."
      },
      "brand-600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.114,
            0.224,
            0.855
          ],
          "alpha": 1,
          "hex": "#1d39da"
        },
        "$description": "Darkened brand colour for the hover state."
      },
      "success-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.063,
            0.725,
            0.506
          ],
          "alpha": 1,
          "hex": "#10b981"
        },
        "$description": "Colour of a successful outcome."
      },
      "warning-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.961,
            0.62,
            0.043
          ],
          "alpha": 1,
          "hex": "#f59e0b"
        },
        "$description": "Colour of a warning."
      },
      "danger-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.957,
            0.247,
            0.369
          ],
          "alpha": 1,
          "hex": "#f43f5e"
        },
        "$description": "Colour of an error or a destructive action."
      }
    },
    "dimension": {
      "space-100": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "Spacing step of 4px. Smallest step of the scale."
      },
      "space-200": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Spacing step of 8px."
      },
      "space-400": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Spacing step of 16px. Base step of the scale."
      },
      "space-600": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "Spacing step of 24px."
      },
      "space-800": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$description": "Spacing step of 32px. Separates large blocks."
      },
      "radius-100": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "Corner radius of 4px. Small controls."
      },
      "radius-200": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Corner radius of 8px. Buttons and inputs."
      },
      "radius-300": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Corner radius of 12px. Panels and cards."
      },
      "radius-pill": {
        "$type": "dimension",
        "$value": {
          "value": 999,
          "unit": "px"
        },
        "$description": "Corner radius rounding an element into a pill."
      },
      "border-width-100": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        },
        "$description": "Border width of 1px. Ordinary borders."
      },
      "border-width-200": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "Border width of 2px. Focus ring."
      },
      "font-size-100": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Font size of 12px. Captions and helper text."
      },
      "font-size-200": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "Font size of 14px. Small body text."
      },
      "font-size-300": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Font size of 16px. Body text."
      },
      "font-size-500": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "Font size of 24px. Headings."
      },
      "letter-spacing-tight": {
        "$type": "dimension",
        "$value": {
          "value": -0.4,
          "unit": "px"
        },
        "$description": "Tightened letter spacing for headings."
      },
      "letter-spacing-normal": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$description": "Neutral letter spacing."
      },
      "letter-spacing-wide": {
        "$type": "dimension",
        "$value": {
          "value": 0.4,
          "unit": "px"
        },
        "$description": "Loosened letter spacing for small labels."
      }
    },
    "fontFamily": {
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "Arial",
          "sans-serif"
        ],
        "$description": "Body text typeface."
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Sora",
          "Arial",
          "sans-serif"
        ],
        "$description": "Heading typeface."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "Courier New",
          "monospace"
        ],
        "$description": "Monospace typeface for code."
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "regular",
        "$description": "Regular weight."
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Medium weight."
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Semi-bold weight."
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "bold",
        "$description": "Bold weight."
      }
    },
    "duration": {
      "none": {
        "$type": "duration",
        "$value": {
          "value": 0,
          "unit": "ms"
        },
        "$description": "Zero duration. Instant state change."
      },
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 120,
          "unit": "ms"
        },
        "$description": "Fast animation of 120ms. Control feedback."
      },
      "moderate": {
        "$type": "duration",
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$description": "Moderate animation of 200ms."
      },
      "slow": {
        "$type": "duration",
        "$value": {
          "value": 320,
          "unit": "ms"
        },
        "$description": "Slow animation of 320ms. Entrance of large surfaces."
      }
    },
    "cubicBezier": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Standard easing curve."
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ],
        "$description": "Emphasized curve for prominent transitions."
      }
    },
    "number": {
      "line-height-tight": {
        "$type": "number",
        "$value": 1.2,
        "$description": "Tight line height for headings."
      },
      "line-height-normal": {
        "$type": "number",
        "$value": 1.5,
        "$description": "Regular line height."
      },
      "line-height-relaxed": {
        "$type": "number",
        "$value": 1.7,
        "$description": "Relaxed line height for long-form text."
      },
      "opacity-disabled": {
        "$type": "number",
        "$value": 0.48,
        "$description": "Opacity of a disabled element."
      },
      "z-dropdown": {
        "$type": "number",
        "$value": 1000,
        "$description": "Stacking level of dropdown layers."
      },
      "z-modal": {
        "$type": "number",
        "$value": 1050,
        "$description": "Stacking level of modal layers."
      }
    },
    "strokeStyle": {
      "solid": {
        "$type": "strokeStyle",
        "$value": "solid",
        "$description": "Solid line."
      },
      "dashed-round": {
        "$type": "strokeStyle",
        "$value": {
          "dashArray": [
            {
              "value": 8,
              "unit": "px"
            },
            {
              "value": 4,
              "unit": "px"
            }
          ],
          "lineCap": "round"
        },
        "$description": "Dashed line with rounded caps."
      }
    },
    "border": {
      "subtle": {
        "$type": "border",
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.796,
              0.835,
              0.882
            ],
            "alpha": 1,
            "hex": "#cbd5e1"
          },
          "width": {
            "value": 1,
            "unit": "px"
          },
          "style": "solid"
        },
        "$description": "Unobtrusive border of 1px."
      },
      "focus-ring": {
        "$type": "border",
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.145,
              0.286,
              0.965
            ],
            "alpha": 1,
            "hex": "#2549f6"
          },
          "width": {
            "value": 2,
            "unit": "px"
          },
          "style": {
            "dashArray": [
              {
                "value": 8,
                "unit": "px"
              },
              {
                "value": 4,
                "unit": "px"
              }
            ],
            "lineCap": "round"
          }
        },
        "$description": "Focus ring of 2px in the brand colour."
      }
    },
    "transition": {
      "standard": {
        "$type": "transition",
        "$value": {
          "duration": {
            "value": 120,
            "unit": "ms"
          },
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": [
            0.2,
            0,
            0,
            1
          ]
        },
        "$description": "Standard transition: fast, with the standard curve."
      },
      "emphasized": {
        "$type": "transition",
        "$value": {
          "duration": {
            "value": 200,
            "unit": "ms"
          },
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": [
            0.2,
            0.8,
            0.2,
            1
          ]
        },
        "$description": "Emphasized transition: moderate, with the emphasized curve."
      }
    },
    "shadow": {
      "surface": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.12,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Shadow of a raised surface."
      },
      "overlay": {
        "$type": "shadow",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ],
              "alpha": 0.12,
              "hex": "#000000"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 8,
              "unit": "px"
            },
            "blur": {
              "value": 20,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          },
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ],
              "alpha": 0.25,
              "hex": "#000000"
            },
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 16,
              "unit": "px"
            },
            "blur": {
              "value": 32,
              "unit": "px"
            },
            "spread": {
              "value": -8,
              "unit": "px"
            }
          }
        ],
        "$description": "Deep shadow of a floating layer."
      }
    },
    "gradient": {
      "brand": {
        "$type": "gradient",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0.145,
                0.286,
                0.965
              ],
              "alpha": 1,
              "hex": "#2549f6"
            },
            "position": 0
          },
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0.114,
                0.224,
                0.855
              ],
              "alpha": 1,
              "hex": "#1d39da"
            },
            "position": 1
          }
        ],
        "$description": "Brand gradient for accent surfaces."
      },
      "attention": {
        "$type": "gradient",
        "$value": [
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0.961,
                0.62,
                0.043
              ],
              "alpha": 1,
              "hex": "#f59e0b"
            },
            "position": 0
          },
          {
            "color": {
              "colorSpace": "srgb",
              "components": [
                0.957,
                0.247,
                0.369
              ],
              "alpha": 1,
              "hex": "#f43f5e"
            },
            "position": 1
          }
        ],
        "$description": "Attention-seeking gradient from warning to danger."
      }
    },
    "typography": {
      "body-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": [
            "Inter",
            "Arial",
            "sans-serif"
          ],
          "fontSize": {
            "value": 14,
            "unit": "px"
          },
          "fontWeight": "regular",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.5
        },
        "$description": "Composition of small body text."
      },
      "body-md": {
        "$type": "typography",
        "$value": {
          "fontFamily": [
            "Inter",
            "Arial",
            "sans-serif"
          ],
          "fontSize": {
            "value": 16,
            "unit": "px"
          },
          "fontWeight": 500,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.7
        },
        "$description": "Composition of body text."
      },
      "title-lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": [
            "Sora",
            "Arial",
            "sans-serif"
          ],
          "fontSize": {
            "value": 24,
            "unit": "px"
          },
          "fontWeight": "bold",
          "letterSpacing": {
            "value": -0.4,
            "unit": "px"
          },
          "lineHeight": 1.2
        },
        "$description": "Composition of a large heading."
      },
      "code-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": [
            "JetBrains Mono",
            "Courier New",
            "monospace"
          ],
          "fontSize": {
            "value": 12,
            "unit": "px"
          },
          "fontWeight": "regular",
          "letterSpacing": {
            "value": 0.4,
            "unit": "px"
          },
          "lineHeight": 1.5
        },
        "$description": "Composition of inline code."
      }
    }
  },
  "semantic": {
    "color": {
      "background-page": {
        "$value": "{primitive.color.white}",
        "$description": "Page background."
      },
      "background-surface": {
        "$value": "{primitive.color.white}",
        "$description": "Background of a surface raised above the page."
      },
      "background-overlay": {
        "$value": "{primitive.color.overlay-40}",
        "$description": "Dimming beneath a modal layer."
      },
      "text-default": {
        "$value": "{primitive.color.slate-900}",
        "$description": "Primary text colour."
      },
      "text-muted": {
        "$value": "{primitive.color.slate-600}",
        "$description": "Muted secondary text."
      },
      "text-inverse": {
        "$value": "{primitive.color.white}",
        "$description": "Text on a dark or brand background."
      },
      "border-default": {
        "$value": "{primitive.color.slate-300}",
        "$description": "Colour of an ordinary border."
      },
      "border-focus": {
        "$value": "{primitive.color.brand-500}",
        "$description": "Border colour in the focus state."
      },
      "action-primary": {
        "$value": "{primitive.color.brand-500}",
