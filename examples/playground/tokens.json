      },
      "control-block": {
        "$value": "{primitive.dimension.space-200}",
        "$description": "Vertical padding of a control."
      },
      "card-padding": {
        "$value": "{primitive.dimension.space-600}",
        "$description": "Padding of a card."
      },
      "section-gap": {
        "$value": "{primitive.dimension.space-800}",
        "$description": "Gap between page sections."
      }
    },
    "shape": {
      "radius-control": {
        "$value": "{primitive.dimension.radius-200}",
        "$description": "Corner radius of a control."
      },
      "radius-panel": {
        "$value": "{primitive.dimension.radius-300}",
        "$description": "Corner radius of a panel or card."
      },
      "radius-pill": {
        "$value": "{primitive.dimension.radius-pill}",
        "$description": "Corner radius of a pill-shaped element."
      },
      "border-subtle": {
        "$value": "{primitive.border.subtle}",
        "$description": "Unobtrusive border."
      },
      "border-focus": {
        "$value": "{primitive.border.focus-ring}",
        "$description": "Border in the focus state."
      }
    },
    "motion": {
      "transition-default": {
        "$value": "{primitive.transition.standard}",
        "$description": "Default transition."
      },
      "transition-emphasized": {
        "$value": "{primitive.transition.emphasized}",
        "$description": "Emphasized transition."
      },
      "shadow-surface": {
        "$value": "{primitive.shadow.surface}",
        "$description": "Surface shadow."
      },
      "shadow-overlay": {
        "$value": "{primitive.shadow.overlay}",
        "$description": "Floating layer shadow."
      }
    },
    "text": {
      "body-small": {
        "$value": "{primitive.typography.body-sm}",
        "$description": "Small body text."
      },
      "body-default": {
        "$value": "{primitive.typography.body-md}",
        "$description": "Body text."
      },
      "title-primary": {
        "$value": "{primitive.typography.title-lg}",
        "$description": "Primary heading."
      },
      "code-inline": {
        "$value": "{primitive.typography.code-sm}",
        "$description": "Inline code."
      },
      "family-body": {
        "$value": "{primitive.fontFamily.body}",
        "$description": "Body text typeface."
      },
      "weight-strong": {
        "$value": "{primitive.fontWeight.semibold}",
        "$description": "Weight used for emphasis."
      }
    },
    "surface": {
      "hero-gradient": {
        "$value": "{primitive.gradient.brand}",
        "$description": "Gradient of the main accent area."
      },
      "attention-gradient": {
        "$value": "{primitive.gradient.attention}",
        "$description": "Gradient of an area demanding attention."
      }
    },
    "layer": {
      "dropdown": {
        "$value": "{primitive.number.z-dropdown}",
        "$description": "Stacking level of a dropdown layer."
