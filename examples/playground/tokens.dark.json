{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
      "white": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "alpha": 1.0,
          "hex": "#ffffff"
        },
        "$description": "Absolute white. Unchanged in the dark theme."
      },
      "black": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.0,
            0.0
          ],
          "alpha": 1.0,
          "hex": "#000000"
        },
        "$description": "Absolute black. Unchanged in the dark theme."
      },
      "overlay-40": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.0,
            0.0
          ],
          "alpha": 0.64,
          "hex": "#000000"
        },
        "$description": "Denser background dimming in the dark theme."
      },
      "slate-100": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1176,
            0.1608,
            0.2314
          ],
          "alpha": 1.0,
          "hex": "#1e293b"
        },
        "$description": "The light neutral becomes a surface background in the dark theme."
      },
      "slate-300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2,
            0.2549,
            0.3333
          ],
          "alpha": 1.0,
          "hex": "#334155"
        },
        "$description": "Mid neutral. Borders and dividers in the dark theme."
      },
      "slate-600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5804,
            0.6392,
            0.7216
          ],
          "alpha": 1.0,
          "hex": "#94a3b8"
        },
        "$description": "The dark neutral becomes muted text in the dark theme."
      },
      "slate-900": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9451,
            0.9608,
            0.9765
          ],
          "alpha": 1.0,
          "hex": "#f1f5f9"
        },
        "$description": "The darkest neutral becomes primary text in the dark theme."
      },
      "brand-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.3804,
            0.5137,
            0.9725
          ],
          "alpha": 1.0,
          "hex": "#6183f8"
        },
        "$description": "Lightened brand colour for sufficient contrast on a dark background."
      },
      "brand-600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5451,
            0.6431,
            0.9804
          ],
          "alpha": 1.0,
          "hex": "#8ba4fa"
        },
        "$description": "Lightened brand hover colour in the dark theme."
      },
      "success-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2902,
            0.8706,
            0.502
          ],
          "alpha": 1.0,
          "hex": "#4ade80"
        },
        "$description": "Lightened success colour for a dark background."
      },
      "warning-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9843,
            0.749,
            0.1412
          ],
          "alpha": 1.0,
          "hex": "#fbbf24"
        },
        "$description": "Lightened warning colour for a dark background."
      },
      "danger-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9725,
            0.4431,
            0.4431
          ],
          "alpha": 1.0,
          "hex": "#f87171"
        },
        "$description": "Lightened danger colour for a dark background."
      }
    },
    "shadow": {
      "surface": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.4,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Denser surface shadow: a soft shadow does not read on a dark background."
      },
      "overlay": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.64,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 32,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Denser floating layer shadow in the dark theme."
      }
    }
  }
}
