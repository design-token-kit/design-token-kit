{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
        "red": {
          "400": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.969,
                0.388,
                0.322
              ],
              "alpha": 1,
              "hex": "#f76352"
            }
          },
          "500": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.941,
                0.275,
                0.224
              ],
              "alpha": 1,
              "hex": "#f04639"
            }
          },
          "600": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.839,
                0.192,
                0.145
              ],
              "alpha": 1,
              "hex": "#d63125"
            }
          },
          "700": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.698,
                0.133,
                0.09
              ],
              "alpha": 1,
              "hex": "#b22217"
            }
          }
        },
        "orange": {
          "400": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.969,
                0.549,
                0.051
              ],
              "alpha": 1,
              "hex": "#f78c0d"
            }
          },
          "500": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.918,
                0.482,
                0.008
              ],
              "alpha": 1,
              "hex": "#ea7b02"
            }
          },
          "600": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.808,
                0.4,
                0.004
              ],
              "alpha": 1,
              "hex": "#ce6601"
            }
          }
        }
    }
  },
  "semantic": {
    "color": {
      "brand": {
        "400": { "$type": "color", "$value": "{primitive.color.red.400}" },
        "500": { "$type": "color", "$value": "{primitive.color.red.500}" },
        "600": { "$type": "color", "$value": "{primitive.color.red.600}" },
        "700": { "$type": "color", "$value": "{primitive.color.red.700}" }
      },
      "accent": {
        "400": { "$type": "color", "$value": "{primitive.color.orange.400}" },
        "500": { "$type": "color", "$value": "{primitive.color.orange.500}" },
        "600": { "$type": "color", "$value": "{primitive.color.orange.600}" }
      },
      "success": {
        "400": { "$type": "color", "$value": "{primitive.color.green.400}" },
        "500": { "$type": "color", "$value": "{primitive.color.green.500}" },
        "600": { "$type": "color", "$value": "{primitive.color.green.600}" }
      },
      "warning": {
        "400": { "$type": "color", "$value": "{primitive.color.amber.400}" },
        "500": { "$type": "color", "$value": "{primitive.color.amber.500}" },
        "600": { "$type": "color", "$value": "{primitive.color.amber.600}" }
      },
      "danger": {
        "400": { "$type": "color", "$value": "{primitive.color.rose.400}" },
        "500": { "$type": "color", "$value": "{primitive.color.rose.500}" },
        "600": { "$type": "color", "$value": "{primitive.color.rose.600}" }
      },
      "info": {
        "400": { "$type": "color", "$value": "{primitive.color.sky.400}" },
        "500": { "$type": "color", "$value": "{primitive.color.sky.500}" },
        "600": { "$type": "color", "$value": "{primitive.color.sky.600}" }
      }
    }
  }
}
