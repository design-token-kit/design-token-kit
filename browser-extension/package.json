{
    "name": "@design-token-kit/browser-extension",
    "version": "3.0.0",
    "private": true,
    "description": "Chromium DevTools extension that traces element styles back to design tokens",
    "type": "module",
    "imports": {
        "#/browser-extension/*": "./src/*"
    },
    "scripts": {
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:coverage:v8": "vitest run --coverage --coverage.provider=v8"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "@design-token-kit/core": "3.0.0"
    },
    "devDependencies": {
        "@types/chrome": "0.3.6",
        "@types/node": "24.10.1",
        "@vitest/coverage-istanbul": "4.1.7",
        "@vitest/coverage-v8": "4.1.7",
        "typescript": "5.9.3",
        "vite": "8.0.10",
        "vitest": "4.1.7"
    }
}
