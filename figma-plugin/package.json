{
    "name": "@design-token-kit/figma-plugin",
    "version": "3.2.0",
    "private": true,
    "description": "Figma plugin for exporting file JSON through REST and Plugin API",
    "type": "module",
    "imports": {
        "#/figma-plugin/*": "./src/*"
    },
    "main": "code.js",
    "scripts": {
        "build": "tsc --noEmit && vite build",
        "build:development": "tsc --noEmit && vite build --mode development",
        "lint": "eslint .",
        "test": "tsc --noEmit && vite build --mode test && vitest run",
        "test:coverage": "tsc --noEmit && vite build --mode test && vitest run --coverage",
        "lint:fix": "eslint . --fix",
        "watch": "tsc --noEmit && vite build --mode development --watch"
    },
    "author": "",
    "license": "MIT",
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "@design-token-kit/core": "3.2.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@figma/eslint-plugin-figma-plugins": "1.0.0",
        "@figma/plugin-typings": "1.131.0",
        "@types/jsdom": "21.1.7",
        "@types/node": "24.10.1",
        "@vitest/coverage-istanbul": "4.1.12",
        "eslint": "9.39.4",
        "jsdom": "26.1.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.57.1",
        "vite": "8.3.7",
        "vitest": "4.1.12"
    }
}
