{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["@figma/plugin-typings", "node", "vitest"],
        "baseUrl": ".",
        "paths": {
            "@design-token-kit/core": ["../core/src/index.ts"],
            "@design-token-kit/core/*": ["../core/src/*"],
            "#/core/io/DtcgListLoader": ["src/core-adapter/DtcgListLoader.ts"],
            "#/*": ["../core/src/*"]
        }
    },
    "include": ["src", "test", "vite.config.ts"]
}
